    {
      "name": "3. Ordem de serviço e saga",
      "item": [
        {
          "name": "Abrir OS (inicia a saga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/service-orders",
            "description": "Abre a OS e manda StartDiagnosis ao execution-service. Daqui em diante o fluxo segue pelo execution (diagnóstico e reparo) e pelo billing (orçamento e pagamento); a OS muda de status pelas respostas da saga.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requester_document\": \"{{cpf}}\",\n  \"vehicle_plate\": \"{{plate}}\",\n  \"notes\": \"barulho na suspensão\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const b = pm.response.json(); pm.collectionVariables.set('os_id', b.id); pm.collectionVariables.set('os_code', b.code); }",
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir OS com falha no orçamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Simulate-Failure",
                "value": "budget"
              }
            ],
            "url": "{{base_url}}/api/v1/service-orders",
            "description": "Com FAULT_INJECTION_ENABLED=true, o billing recusa criar o orçamento: a saga compensa (devolve peças, cancela a execução) e a OS termina cancelled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requester_document\": \"{{cpf}}\",\n  \"vehicle_plate\": \"{{plate}}\",\n  \"notes\": \"barulho na suspensão\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('os_id', pm.response.json().id); }",
                  "pm.test('status 201', () => pm.expect(pm.response.code).to.be.below(300));"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir OS com falha no pagamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Simulate-Failure",
                "value": "payment"
              }
            ],
            "url": "{{base_url}}/api/v1/service-orders",
            "description": "O pagamento é recusado depois da aprovação: cancela o orçamento, devolve as peças e cancela a execução.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requester_document\": \"{{cpf}}\",\n  \"vehicle_plate\": \"{{plate}}\",\n  \"notes\": \"barulho na suspensão\"\n}",
              "options": {
