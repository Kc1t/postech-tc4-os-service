{
  "info": {
    "name": "postech-tc4 · os-service",
    "description": "Ordens de serviço, catálogo e orquestrador da saga.\n\nLocal: base_url = http://localhost:8080. Pelo API Gateway: base_url = gateway_url (as rotas mantêm o /api/v1). O orçamento e o pagamento estão na collection do billing-service; diagnóstico e reparo, na do execution-service. O fluxo completo da saga, com espera entre as etapas, está em postech-tc4-infra-k8s/local/e2e.sh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "gateway_url",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": "admin123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "client_token",
      "value": ""
    },
    {
      "key": "internal_token",
      "value": ""
    },
    {
      "key": "cpf",
      "value": "52998224725"
    },
    {
      "key": "plate",
      "value": "DEM0A01"
    },
    {
      "key": "requester_id",
      "value": ""
    },
    {
      "key": "vehicle_id",
      "value": ""
    },
    {
      "key": "service_id",
      "value": ""
    },
    {
      "key": "part_id",
      "value": ""
    },
    {
      "key": "os_id",
      "value": ""
    },
    {
      "key": "os_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login da equipe (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Grava o access token em {{token}}, usado por toda a collection.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@workshop.com\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', b.access_token);",
                  "pm.collectionVariables.set('refresh_token', b.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh do token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.collectionVariables.set('token', b.access_token); pm.collectionVariables.set('refresh_token', b.refresh_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar usuário da equipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mecânico Demo\",\n  \"email\": \"mecanico.demo@workshop.com\",\n  \"password\": \"senha-forte-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/logout",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Token do cliente por CPF (Lambda issuer, só pelo gateway)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway_url}}/auth",
            "description": "Rota do API Gateway que invoca a Lambda auth-issuer. Grava o JWT do cliente em {{client_token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('client_token', pm.response.json().access_token); }",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
