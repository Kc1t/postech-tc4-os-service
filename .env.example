APP_PORT=8080
APP_ENV=development
LOG_LEVEL=info
NEW_RELIC_APP_NAME=os-service-local
NEW_RELIC_LICENSE_KEY=

POSTGRES_DSN=postgres://postgres:postgres@localhost:5433/workshop?sslmode=disable

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXP_MIN=15
REFRESH_TOKEN_EXP_DAYS=7
BCRYPT_COST=12
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MIN=15
ADMIN_EMAIL=admin@workshop.com
ADMIN_PASSWORD=change-me-in-production

# Origens do navegador permitidas (separadas por vírgula; nunca "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Segredo da rota /internal/requesters (Lambda de autenticação)
INTERNAL_API_TOKEN=change-me

# Mensageria. Em dev aponta para o LocalStack; no EKS, AWS_ENDPOINT_URL fica vazio.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_SAGA_REPLIES_URL=http://localhost:4566/000000000000/os-saga-replies
SQS_BILLING_COMMANDS_URL=http://localhost:4566/000000000000/billing-commands
SQS_EXECUTION_COMMANDS_URL=http://localhost:4566/000000000000/execution-commands
SNS_OS_EVENTS_ARN=arn:aws:sns:us-east-1:000000000000:os-events
OUTBOX_POLL_INTERVAL=500ms

# Saga
SAGA_APPROVAL_TIMEOUT=72h
SAGA_PAYMENT_TIMEOUT=24h
SAGA_TIMEOUT_CHECK_INTERVAL=1m
# Habilita o header X-Simulate-Failure (budget|payment|repair) para demonstrar compensações
FAULT_INJECTION_ENABLED=false

# API composition (GET /service-orders/{id}/details)
BILLING_SERVICE_URL=http://localhost:8082
EXECUTION_SERVICE_URL=http://localhost:8083
UPSTREAM_TIMEOUT=2s
SHUTDOWN_TIMEOUT=20s
