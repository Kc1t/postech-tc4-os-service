{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "billing.CreateBudget",
  "description": "Comando do os-service para o billing-service (fila billing-commands): gera o orçamento da OS a partir do diagnóstico, com os preços do catálogo. Resposta: BudgetCreated ou BudgetCreationFailed.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "billing.CreateBudget"
    },
    "payload": {
      "type": "object",
      "required": [
        "os_code",
        "requester",
        "items",
        "total"
      ],
      "properties": {
        "os_code": {
          "$ref": "common.schema.json#/$defs/osCode"
        },
        "requester": {
          "$ref": "common.schema.json#/$defs/requester"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/item"
          },
          "description": "Serviços e peças diagnosticados."
        },
        "total": {
          "$ref": "common.schema.json#/$defs/money",
          "description": "Soma de quantity × unit_price dos itens (o billing confere)."
        },
        "simulate_failure": {
          "$ref": "common.schema.json#/$defs/simulateFailure",
          "description": "\"budget\" faz o billing responder BudgetCreationFailed."
        }
      },
      "additionalProperties": true
    }
  },
