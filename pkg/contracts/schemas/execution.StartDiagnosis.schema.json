{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "execution.StartDiagnosis",
  "description": "Comando do os-service para o execution-service (fila execution-commands): abre a execução da OS na fila de diagnóstico. Enviado na abertura da OS.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "execution.StartDiagnosis"
    },
    "payload": {
      "type": "object",
      "required": [
        "os_code",
        "vehicle"
      ],
      "properties": {
        "os_code": {
          "$ref": "common.schema.json#/$defs/osCode"
        },
        "vehicle": {
          "$ref": "common.schema.json#/$defs/vehicle"
        },
        "notes": {
          "type": "string",
          "description": "Observações da abertura (omitidas quando vazias)."
        },
        "simulate_failure": {
          "$ref": "common.schema.json#/$defs/simulateFailure",
          "description": "Reservado; o os-service não envia falha simulada no diagnóstico."
        }
      },
      "additionalProperties": true
    }
  },
  "examples": [
