{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "billing.RequestPayment",
  "description": "Comando do os-service para o billing-service (fila billing-commands): cria a cobrança do orçamento aprovado. Resposta: PaymentLinkCreated (ou PaymentApproved, se já pago) ou PaymentFailed.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "billing.RequestPayment"
    },
    "payload": {
      "type": "object",
      "required": [
        "budget_id"
      ],
      "properties": {
        "budget_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "Orçamento aprovado (budget_id do BudgetCreated)."
        },
        "simulate_failure": {
          "$ref": "common.schema.json#/$defs/simulateFailure",
          "description": "\"payment\" faz o billing responder PaymentFailed."
        }
      },
      "additionalProperties": true
    }
  },
