{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "billing.PaymentLinkCreated",
  "description": "Evento do billing-service (tópico billing-events → fila os-saga-replies): cobrança criada no provedor. O os-service avisa o cliente com o link de checkout.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "billing.PaymentLinkCreated"
    },
    "payload": {
      "type": "object",
      "required": [
        "budget_id",
        "payment_id",
        "checkout_url"
      ],
      "properties": {
        "budget_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "Orçamento cobrado."
        },
        "payment_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "ID do pagamento no billing-service."
        },
        "checkout_url": {
          "type": "string",
          "format": "uri",
          "description": "Link do checkout (Mercado Pago ou checkout fake local)."
        }
      },
      "additionalProperties": true
    }
  },
  "examples": [
