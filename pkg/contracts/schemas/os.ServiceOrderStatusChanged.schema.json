{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "os.ServiceOrderStatusChanged",
  "description": "Evento do os-service (tópico os-events → fila notification-os-events): a OS mudou de status. A Lambda de notificação avisa o cliente por e-mail.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "os.ServiceOrderStatusChanged"
    },
    "payload": {
      "type": "object",
      "required": [
        "os_code",
        "status",
        "previous_status",
        "requester",
        "total_amount"
      ],
      "properties": {
        "os_code": {
          "$ref": "common.schema.json#/$defs/osCode"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/orderStatus",
          "description": "Status novo."
        },
        "previous_status": {
          "type": "string",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/orderStatus"
            },
            {
              "const": ""
            }
          ],
          "description": "Status anterior; vazio no evento de abertura da OS."
        },
        "requester": {
          "$ref": "common.schema.json#/$defs/requester"
        },
        "total_amount": {
          "$ref": "common.schema.json#/$defs/money",
          "description": "Total da OS (zero antes do diagnóstico)."
        },
        "checkout_url": {
          "type": "string",
          "format": "uri",
          "description": "Link de pagamento; só vem em awaiting_payment, depois do PaymentLinkCreated."
        },
        "reason": {
          "type": "string",
          "description": "Motivo do cancelamento (omitido quando vazio)."
        }
      },
      "additionalProperties": true
    }
  },
  "examples": [
